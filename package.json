{
  "name": "zp-intake-portal",
  "private": true,
  "description": "ZinkPress gated client intake portal: No Credentials, No Clock.",
  "workspaces": [
    "packages/shared",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:web": "npm run dev --workspace apps/web",
    "test": "npm run test --workspace apps/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace apps/web",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply zp-intake --local",
    "db:migrate:remote": "wrangler d1 migrations apply zp-intake --remote",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "wrangler": "^4.167.0"
  }
}
